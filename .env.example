# Copy to .env and fill in. Never commit .env. Values only: no quotes, no spaces, no comments on the same line.
HELPDESK_KEY=nrd_round_...
CANDIDATE_EMAIL=you@example.com
CANDIDATE_NAME=Your Full Name

# --- Model option A: Anthropic (paid API key) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Model option B: any OpenAI-compatible API, e.g. Google Gemini free tier (no billing needed) ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<key from aistudio.google.com>
# LLM_MODEL=<a Flash model id shown in Google AI Studio>
# LLM_MIN_INTERVAL=5

# --- Optional ---
# HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
# CONFIDENCE_MIN=0.75
